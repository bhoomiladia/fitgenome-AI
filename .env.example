# ── Database ──────────────────────────────────────────────
POSTGRES_USER=fitgenome
POSTGRES_PASSWORD=fitgenome_secret
POSTGRES_DB=fitgenome_db
DATABASE_URL=postgresql://fitgenome:fitgenome_secret@db:5432/fitgenome_db

# ── JWT / Security ────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── OpenRouter ────────────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemini-2.0-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Gemini (Vision pipeline + fallback LLM) ───────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
LLM_PROVIDER_ORDER=openrouter,gemini

# ── Vision Pipeline ───────────────────────────────────────
GEMINI_VISION_MODEL=gemini-2.5-flash-lite
VISION_LATENCY_THRESHOLD_MS=8000
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash
IMAGE_MIN_SIZE_PX=200
IMAGE_MAX_SIZE_PX=2048
IMAGE_BLUR_THRESHOLD=10.0
