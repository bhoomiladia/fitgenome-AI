# ── Database ──────────────────────────────────────────────
POSTGRES_USER=fitgenome
POSTGRES_PASSWORD=fitgenome_secret
POSTGRES_DB=fitgenome_db
DATABASE_URL=postgresql+asyncpg://fitgenome:fitgenome_secret@db:5432/fitgenome_db

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT / Security ────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── AI / RAG ──────────────────────────────────────────────

PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=fitgenome-knowledge
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ── LLM Fallbacks ─────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
LLM_PROVIDER_ORDER=gemini,groq

# ── Vision Pipeline ───────────────────────────────────────
GEMINI_VISION_MODEL=gemini-2.5-flash-lite
VISION_LATENCY_THRESHOLD_MS=8000
GROQ_VISION_MODEL=llava-v1.5-7b-4096-preview
IMAGE_MIN_SIZE_PX=200
IMAGE_MAX_SIZE_PX=2048
IMAGE_BLUR_THRESHOLD=100.0

# ── Celery ────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
